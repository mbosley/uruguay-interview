# LLM Provider API Keys
# At least one of these is required

# Moonshot AI (Default provider)
MOONSHOT_API_KEY=your-moonshot-api-key-here

# Groq (Fast alternative)
GROQ_API_KEY=your-groq-api-key-here

# OpenAI (High quality alternative)
OPENAI_API_KEY=your-openai-api-key-here

# Optional: Set default provider (moonshot, groq, or openai)
# KIMI_PROVIDER=moonshot

# Optional: Debug mode
# DEBUG=true