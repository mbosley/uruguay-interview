# LLM Provider API Keys
# At least one of these is required

# Moonshot AI (Default provider)
MOONSHOT_API_KEY=your-moonshot-api-key-here

# Groq (Fast alternative)
GROQ_API_KEY=your-groq-api-key-here

# Optional: Set default provider (moonshot or groq)
# KIMI_PROVIDER=moonshot

# Optional: Debug mode
# DEBUG=true